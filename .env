# Salin file ini jadi ".env" lalu isi sesuai punya kamu.

# API key Ollama Cloud kamu (kalau login pakai `ollama signin` biasanya nggak wajib,
# tapi kalau mau pakai API key langsung, isi di sini)
OLLAMA_API_KEY=ae71969a255a4ef095fcf4470196c980.Cm7V4_fNBfPaaiZBDhRKhySG

# Host Ollama. Biarin kosong kalau pakai ollama lokal yang sudah signin ke cloud
# (default: http://localhost:11434). Isi kalau mau hit API cloud langsung.
OLLAMA_HOST=http://localhost:11434

# Nama model cloud yang mau dipakai
VIBE_MODEL=nemotron-3-ultra:cloud

# Folder dasar tempat agent boleh buat/hapus folder (batas keamanan)
VIBE_BASE_DIR=/home/itachi/fbi-secret/minimax/area  
VIBE_SKILL_DIR=/home/itachi/fbi-secret/minimax/
